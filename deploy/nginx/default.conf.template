log_format taskflow_json escape=json
    '{'
      '"schema_version":"1",'
      '"@timestamp":"$time_iso8601",'
      '"log_level":"Information",'
      '"event_id":1001,'
      '"event_name":"RequestCompleted",'
      '"message":"Frontend request completed",'
      '"service_name":"TaskFlow.Frontend",'
      '"service_version":"__TASKFLOW_SERVICE_VERSION__",'
      '"deployment_environment":"Production",'
      '"instance_id":"$hostname",'
      '"http_method":"$request_method",'
      '"http_path":"$uri",'
      '"http_status_code":$status'
    '}';

resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 8080;
    server_name _;
    access_log off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 308 https://$host:8443$request_uri;
    }
}

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate /tmp/taskflow-tls.crt;
    ssl_certificate_key /tmp/taskflow-tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    access_log /dev/stdout taskflow_json;
    error_log /dev/stderr warn;

    include /etc/nginx/snippets/taskflow-security-headers.conf;
    gzip_static on;
    gzip_vary on;
    etag on;

    location ^~ /health/ {
        return 404;
    }

    location /api/ {
        set $taskflow_api http://api:8080;
        proxy_pass $taskflow_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 8443;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }

    location = /index.html {
        include /etc/nginx/snippets/taskflow-security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # .NET 10 fingerprints framework payloads (for example *.abc123def4.wasm),
    # but bootstrap files such as blazor.webassembly.js keep stable names.
    # Only fingerprinted files are safe for immutable one-year caching.
    location ~ "^/_framework/.+\.[A-Za-z0-9]{10}\.[A-Za-z0-9.]+(?:\.gz)?$" {
        include /etc/nginx/snippets/taskflow-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /_framework/ {
        include /etc/nginx/snippets/taskflow-security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
