# Example only. TaskFlow.DevCli generates .env.compose.local automatically on the first `up`.
# Never commit the generated local file or production secrets.
TASKFLOW_IMAGE_TAG=<full-git-commit-sha>
TASKFLOW_HTTPS_PORT=<derived-per-copy-host-port>
TASKFLOW_BACKEND_SUBNET=<derived-per-copy-subnet>
TASKFLOW_PROXY_IP=<derived-per-copy-proxy-ip>
POSTGRES_SUPERUSER_PASSWORD=<generated-secret>
TASKFLOW_APP_DB_PASSWORD=<generated-secret>
TASKFLOW_MIGRATOR_DB_PASSWORD=<generated-secret>
