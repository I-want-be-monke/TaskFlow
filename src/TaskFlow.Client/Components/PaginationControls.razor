@if (TotalPages > 1)
{
    <nav class="pagination" aria-label="Pagination">
        <button type="button" class="button button-secondary" disabled="@(Page <= 1 || Disabled)" @onclick="PreviousAsync">Previous</button>
        <span>Page @Page of @TotalPages</span>
        <button type="button" class="button button-secondary" disabled="@(Page >= TotalPages || Disabled)" @onclick="NextAsync">Next</button>
    </nav>
}

@code {
    [Parameter]
    public int Page { get; set; }

    [Parameter]
    public long TotalPages { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    private Task PreviousAsync() => PageChanged.InvokeAsync(Page - 1);
    private Task NextAsync() => PageChanged.InvokeAsync(Page + 1);
}
