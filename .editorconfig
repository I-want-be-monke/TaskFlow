root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

[src/TaskFlow.Application/Common/Errors/Error.cs]
# Error is the established application result type; the name is intentional.
dotnet_diagnostic.CA1716.severity = none

[src/TaskFlow.Infrastructure/Persistence/{UnitOfWork.cs,Interceptors/SlowDatabaseCommandInterceptor.cs}]
# Lower-case placeholders are part of the stable structured JSON log contract.
dotnet_diagnostic.CA1727.severity = none

[src/TaskFlow.Infrastructure/Persistence/Migrations/*.cs]
# EF Core migrations are generated source and must remain reproducible.
dotnet_diagnostic.CA1861.severity = none

[src/TaskFlow.Api/**/*.cs]
# Explicit logging calls preserve the verified snake_case JSON event contract.
dotnet_diagnostic.CA1727.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

[src/TaskFlow.Api/*.cs]
# Root composition code emits the same verified structured JSON events.
dotnet_diagnostic.CA1727.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

[src/TaskFlow.DbMigrator/**/*.cs]
# Explicit logging calls preserve the verified snake_case JSON event contract.
dotnet_diagnostic.CA1727.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

[src/TaskFlow.DbMigrator/*.cs]
# Migrator sources live at the project root and use the same logging contract.
dotnet_diagnostic.CA1727.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

[tests/**/*.cs]
# Method_Name_ExpectedResult is the deliberate test naming convention.
dotnet_diagnostic.CA1707.severity = none

[tests/TaskFlow.IntegrationTests/**/*.cs]
# Integration helpers already have bounded Testcontainers/HTTP lifetimes; adding
# TestContext tokens to every nested framework call would obscure the scenarios.
dotnet_diagnostic.xUnit1051.severity = none

[*.{csproj,props,targets,sln,xml,json,yml,yaml,md}]
indent_style = space
indent_size = 2
