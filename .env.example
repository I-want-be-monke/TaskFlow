# Example only. Real secrets must never be committed.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7043
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=taskflow;Username=taskflow_app;Password=CHANGE_ME
# DbMigrator uses the SAME configuration key in its own process environment,
# but with a separate privileged role, for example Username=taskflow_migrator.
# Never give the API runtime connection string schema DDL privileges.
Migrator__LockTimeoutSeconds=30

# Development-only exact CORS allowlist. Production is same-origin and does not enable CORS middleware.
Cors__AllowedOrigins__0=https://localhost:7042

# Browser registration can be disabled without rebuilding the image.
Auth__AllowRegistration=true

# Request and abuse controls.
Security__RateLimit__ApiPermitLimit=100
Security__RateLimit__LoginPermitLimit=10
Security__RateLimit__WindowSeconds=60
Security__RequestTimeoutSeconds=30
Security__MaxRequestBodyBytes=1048576

# Forwarded headers are ignored unless at least one trusted proxy/network is explicitly configured.
Proxy__ForwardLimit=1
Proxy__KnownProxies__0=127.0.0.1
# Proxy__KnownNetworks__0=10.0.0.0/8

# Observability settings are validated at startup.
Observability__ServiceVersion=dev
Observability__InstanceId=taskflow-api-local
Observability__SlowDbThresholdMs=500

Logging__LogLevel__Default=Information
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=CHANGE_ME
